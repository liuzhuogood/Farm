{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Farm AI 自动化接口",
  "description": "面向 AI Agent 的精简自动化接口：统一感知、动作控制、必要设备上下文、视觉条件操作与自动化调用日志。点击和滑动坐标使用 0~1 归一化值。",
  "endpoints": [
    "GET /api/automation/observe",
    "POST /api/automation/observe",
    "GET /api/automation/logs",
    "GET /api/devices",
    "GET /api/devices/{serial}/latest-frame",
    "GET /api/v1/device-status",
    "POST /api/v1/actions/tap",
    "POST /api/v1/actions/swipe",
    "POST /api/v1/actions/send-key",
    "POST /api/v1/actions/events",
    "POST /api/v1/vision/check",
    "POST /api/v1/vision/wait",
    "POST /api/v1/vision/actions/tap-when"
  ]
}
