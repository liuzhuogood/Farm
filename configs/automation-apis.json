{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Farm AI 自动化接口",
  "description": "面向 AI 的格式化文本接口：一行一设备、紧凑页面观察、操作命令与调用记录。",
  "endpoints": [
    "GET /api/automation/devices",
    "GET /api/automation/observe",
    "POST /api/automation/act",
    "GET /api/automation/logs",
    "GET /api/v1/vision/latest-frame",
    "POST /api/v1/vision/latest-frame",
    "GET /api/automation/artifacts",
    "GET /api/automation/artifacts/download",
    "POST /api/automation/tasks",
    "GET /api/automation/tasks",
    "GET /api/automation/tasks/{task_id}",
    "POST /api/automation/tasks/{task_id}/finish"
  ]
}
